{
  "name": "holocad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/prepare-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "verify:landing": "node scripts/verify-landing.mjs",
    "verify:geometry": "node --experimental-strip-types scripts/verify-engine.mjs && node --experimental-strip-types scripts/verify-hero.mjs && node --experimental-strip-types scripts/verify-reveal-trail.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "package:release": "npm run verify:release && node scripts/package-release.mjs",
    "format": "prettier --write src scripts index.html render.html vite.config.ts tsconfig.json package.json",
    "render:intro": "node scripts/render-intro.mjs",
    "generate:voice": "node scripts/generate-voice.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ffmpeg-static": "^5.3.0",
    "lighthouse": "^13.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
